{
	"name": "express-shop",
	"version": "0.1.0",
	"description": "基于 Express、MySQL 和 Prisma 的单商户电商商城后端",
	"type": "module",
	"main": "src/server.js",
	"scripts": {
		"dev": "cross-env NODE_ENV=development nodemon src/server.js",
		"dev:services": "sh scripts/dev-services.sh",
		"dev:services:stop": "sh scripts/dev-services-stop.sh",
		"dev:setup": "npm run dev:services && npm run db:deploy && npm run db:seed",
		"start": "cross-env NODE_ENV=production node src/server.js",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "husky",
		"test": "vitest run --exclude tests/integration/**",
		"test:integration": "sh scripts/test-integration.sh",
		"test:performance": "sh scripts/test-performance.sh",
		"db:backup": "sh scripts/db-backup.sh",
		"db:restore": "sh scripts/db-restore.sh",
		"db:reconcile": "node scripts/reconcile-database.js",
		"test:watch": "vitest",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:seed": "node prisma/seed.js",
		"db:studio": "prisma studio",
		"db:validate": "cross-env DATABASE_URL=mysql://user:password@127.0.0.1:3306/express_shop prisma validate",
		"validate": "npm run lint && npm run format:check && npm test && npm run db:validate"
	},
	"engines": {
		"node": ">=22"
	},
	"lint-staged": {
		"*.js": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,yml,yaml}": "prettier --write"
	},
	"license": "MIT",
	"dependencies": {
		"@prisma/client": "^6.19.3",
		"bcryptjs": "^3.0.3",
		"bullmq": "^6.1.0",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.6.2",
		"file-type": "^21.3.4",
		"helmet": "^8.3.0",
		"ioredis": "^6.0.0",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.2.0",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"prom-client": "^15.1.3",
		"swagger-ui-express": "^5.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@apidevtools/swagger-parser": "^12.1.0",
		"@eslint/js": "^10.0.1",
		"cross-env": "^10.1.0",
		"eslint": "^10.8.1",
		"globals": "^17.11.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"nodemon": "^3.1.14",
		"prettier": "^3.9.6",
		"prisma": "^6.19.3",
		"supertest": "^7.2.2",
		"vitest": "^4.1.10"
	}
}
