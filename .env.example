NODE_ENV=development
PORT=3000
TRUST_PROXY=0
LOG_LEVEL=debug

DATABASE_URL=mysql://express_shop:express_shop@127.0.0.1:3306/express_shop
# 仅供 npm run test:integration 使用
TEST_DATABASE_URL=mysql://express_shop:express_shop@127.0.0.1:3306/express_shop_test
# Docker 默认 root 连接，仅用于创建测试数据库；已有测试库时无需配置
TEST_DATABASE_ADMIN_URL=mysql://root:root@127.0.0.1:3306/mysql
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=http://localhost:5173
SWAGGER_ENABLED=true
METRICS_ENABLED=false
# METRICS_TOKEN=replace-with-at-least-32-random-characters
TASKS_ENABLED=true
SHUTDOWN_TIMEOUT_MS=10000
PUBLIC_BASE_URL=http://localhost:3000
UPLOAD_LOCAL_DIR=uploads
UPLOAD_MAX_IMAGE_MB=5
PASSWORD_RESET_EXPIRES_MINUTES=15
ORDER_PAYMENT_EXPIRES_MINUTES=30
ORDER_AUTO_RECEIVE_DAYS=14
PAYMENT_QUERY_INTERVAL_SECONDS=60
PAYMENT_QUERY_BATCH_SIZE=100
PAYMENT_QUERY_MAX_ATTEMPTS=10
AFTER_SALE_REVIEW_HOURS=24
AFTER_SALE_RETURN_DAYS=7
AFTER_SALE_RECEIVE_HOURS=48
AFTER_SALE_REFUND_HOURS=24
PAYMENT_CALLBACK_SECRET=replace-with-payment-callback-secret
# PAYMENT_CALLBACK_PREVIOUS_SECRET=previous-secret-during-key-rotation
PAYMENT_CALLBACK_TOLERANCE_SECONDS=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
CONTENT_BLOCKED_WORDS=
SESSION_RETENTION_DAYS=90
PASSWORD_RESET_RETENTION_DAYS=30
BROWSING_HISTORY_RETENTION_DAYS=180
CALLBACK_LOG_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=730

# 可选：首次执行 npm run db:seed 时创建管理员
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
