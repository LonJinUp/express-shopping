generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  DELETED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  AFTER_SALE
  REFUNDING
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CLOSED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum InventoryChangeType {
  INITIAL
  MANUAL_ADJUSTMENT
  ORDER_LOCK
  ORDER_RELEASE
  ORDER_DEDUCT
  AFTER_SALE_RETURN
}

enum PaymentCallbackStatus {
  RECEIVED
  PROCESSED
  REJECTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouponScope {
  ALL
  CATEGORY
  PRODUCT
}

enum UserCouponStatus {
  AVAILABLE
  USED
  EXPIRED
}

enum HomeBlockType {
  BANNER
  RECOMMENDATION
  ANNOUNCEMENT
}

enum AfterSaleType {
  REFUND_ONLY
  RETURN_REFUND
}

enum AfterSaleStatus {
  PENDING
  APPROVED
  WAITING_RETURN
  RETURNED
  REFUNDING
  COMPLETED
  REJECTED
  CANCELLED
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

model Merchant {
  id        String   @id @default(cuid()) @db.VarChar(30)
  name      String   @db.VarChar(120)
  code      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shops     Shop[]
}

model Shop {
  id         String     @id @default(cuid()) @db.VarChar(30)
  merchantId String     @db.VarChar(30)
  name       String     @db.VarChar(120)
  code       String     @unique @db.VarChar(50)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  merchant   Merchant   @relation(fields: [merchantId], references: [id])
  products   Product[]
  orders     Order[]
  coupons    Coupon[]
  shippingTemplates ShippingTemplate[]

  @@index([merchantId])
}

model User {
  id           String        @id @default(cuid()) @db.VarChar(30)
  email        String?       @unique @db.VarChar(191)
  phone        String?       @unique @db.VarChar(30)
  passwordHash String        @db.VarChar(191)
  nickname     String        @db.VarChar(80)
  avatarUrl    String?       @db.VarChar(500)
  status       UserStatus    @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  addresses    UserAddress[]
  roles        UserRole[]
  cartItems    CartItem[]
  orders       Order[]
  sessions     UserSession[]
  passwordResetTokens PasswordResetToken[]
  reviews      Review[]
  coupons      UserCoupon[]
  favorites    Favorite[]
  browsingHistory BrowsingHistory[]
  afterSales   AfterSale[]
}

model UserSession {
  id               String    @id @default(cuid()) @db.VarChar(30)
  userId           String    @db.VarChar(30)
  refreshTokenHash String    @unique @db.Char(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?   @db.VarChar(500)
  ip               String?   @db.VarChar(80)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid()) @db.VarChar(30)
  userId    String    @db.VarChar(30)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
  @@index([usedAt])
}

model Role {
  id          String           @id @default(cuid()) @db.VarChar(30)
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(80)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid()) @db.VarChar(30)
  code  String           @unique @db.VarChar(100)
  name  String           @db.VarChar(100)
  roles RolePermission[]
}

model UserRole {
  userId String @db.VarChar(30)
  roleId String @db.VarChar(30)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.VarChar(30)
  permissionId String     @db.VarChar(30)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserAddress {
  id            String   @id @default(cuid()) @db.VarChar(30)
  userId        String   @db.VarChar(30)
  recipientName String   @db.VarChar(80)
  phone         String   @db.VarChar(30)
  province      String   @db.VarChar(80)
  city          String   @db.VarChar(80)
  district      String   @db.VarChar(80)
  detail        String   @db.VarChar(255)
  postalCode    String?  @db.VarChar(20)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model Category {
  id        String     @id @default(cuid()) @db.VarChar(30)
  parentId  String?    @db.VarChar(30)
  name      String     @db.VarChar(100)
  slug      String     @unique @db.VarChar(120)
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  couponScopes CouponCategory[]

  @@index([parentId, sortOrder])
}

model Brand {
  id        String    @id @default(cuid()) @db.VarChar(30)
  name      String    @unique @db.VarChar(100)
  logoUrl   String?   @db.VarChar(500)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          String        @id @default(cuid()) @db.VarChar(30)
  shopId      String        @db.VarChar(30)
  categoryId  String        @db.VarChar(30)
  brandId     String?       @db.VarChar(30)
  name        String        @db.VarChar(191)
  subtitle    String?       @db.VarChar(255)
  slug        String        @unique @db.VarChar(191)
  description String?       @db.LongText
  status      ProductStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  shop        Shop          @relation(fields: [shopId], references: [id])
  category    Category      @relation(fields: [categoryId], references: [id])
  brand       Brand?        @relation(fields: [brandId], references: [id])
  images      ProductImage[]
  skus        ProductSku[]
  couponScopes CouponProduct[]
  favorites    Favorite[]
  browsingHistory BrowsingHistory[]

  @@index([shopId, status, createdAt])
  @@index([categoryId, status])
  @@index([brandId])
  @@index([status, sortOrder, createdAt])
  @@index([categoryId, status, sortOrder, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid()) @db.VarChar(30)
  productId String  @db.VarChar(30)
  url       String  @db.VarChar(500)
  alt       String? @db.VarChar(191)
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductSku {
  id             String         @id @default(cuid()) @db.VarChar(30)
  productId      String         @db.VarChar(30)
  skuCode        String         @unique @db.VarChar(80)
  name           String         @db.VarChar(191)
  specifications Json
  price          Int            @db.UnsignedInt
  marketPrice    Int?           @db.UnsignedInt
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  product        Product        @relation(fields: [productId], references: [id])
  inventory      Inventory?
  inventoryLogs  InventoryLog[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([productId, isActive, price])
}

model Inventory {
  skuId     String     @id @db.VarChar(30)
  available Int        @default(0) @db.UnsignedInt
  locked    Int        @default(0) @db.UnsignedInt
  version   Int        @default(0) @db.UnsignedInt
  updatedAt DateTime   @updatedAt
  sku       ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
}

model InventoryLog {
  id            String              @id @default(cuid()) @db.VarChar(30)
  skuId         String              @db.VarChar(30)
  type          InventoryChangeType
  availableDiff Int
  lockedDiff    Int
  referenceType String?             @db.VarChar(50)
  referenceId   String?             @db.VarChar(50)
  operatorId    String?             @db.VarChar(30)
  remark        String?             @db.VarChar(255)
  createdAt     DateTime            @default(now())
  sku           ProductSku          @relation(fields: [skuId], references: [id])

  @@index([skuId, createdAt])
  @@index([referenceType, referenceId])
}

model CartItem {
  id        String     @id @default(cuid()) @db.VarChar(30)
  userId    String     @db.VarChar(30)
  skuId     String     @db.VarChar(30)
  quantity  Int        @db.UnsignedInt
  selected  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku       ProductSku @relation(fields: [skuId], references: [id])

  @@unique([userId, skuId])
  @@index([skuId])
}

model Order {
  id             String      @id @default(cuid()) @db.VarChar(30)
  orderNo        String      @unique @db.VarChar(32)
  clientRequestId String     @db.VarChar(64)
  userId         String      @db.VarChar(30)
  shopId         String      @db.VarChar(30)
  status         OrderStatus @default(PENDING_PAYMENT)
  goodsAmount    Int         @db.UnsignedInt
  discountAmount Int         @default(0) @db.UnsignedInt
  shippingAmount Int         @default(0) @db.UnsignedInt
  payableAmount  Int         @db.UnsignedInt
  paidAmount     Int         @default(0) @db.UnsignedInt
  refundedAmount Int         @default(0) @db.UnsignedInt
  buyerMessage   String?     @db.VarChar(255)
  userCouponId   String?     @unique @db.VarChar(30)
  couponCode     String?     @db.VarChar(50)
  expiresAt      DateTime
  paidAt         DateTime?
  shippedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id])
  shop           Shop        @relation(fields: [shopId], references: [id])
  address        OrderAddress?
  items          OrderItem[]
  logs           OrderLog[]
  payments       Payment[]
  shipment       Shipment?
  notes          OrderNote[]
  userCoupon     UserCoupon? @relation(fields: [userCouponId], references: [id])
  afterSales     AfterSale[]

  @@index([userId, status, createdAt])
  @@index([shopId, status, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@unique([userId, clientRequestId])
  @@index([status, expiresAt])
}

model OrderAddress {
  orderId       String @id @db.VarChar(30)
  recipientName String @db.VarChar(80)
  phone         String @db.VarChar(30)
  province      String @db.VarChar(80)
  city          String @db.VarChar(80)
  district      String @db.VarChar(80)
  detail        String @db.VarChar(255)
  postalCode    String? @db.VarChar(20)
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id             String     @id @default(cuid()) @db.VarChar(30)
  orderId        String     @db.VarChar(30)
  skuId          String     @db.VarChar(30)
  productName    String     @db.VarChar(191)
  skuName        String     @db.VarChar(191)
  skuCode        String     @db.VarChar(80)
  specifications Json
  imageUrl       String?    @db.VarChar(500)
  unitPrice      Int        @db.UnsignedInt
  quantity       Int        @db.UnsignedInt
  goodsAmount    Int        @db.UnsignedInt
  discountAmount Int        @default(0) @db.UnsignedInt
  payableAmount  Int        @db.UnsignedInt
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku            ProductSku @relation(fields: [skuId], references: [id])
  review         Review?
  afterSaleItems AfterSaleItem[]

  @@index([orderId])
  @@index([skuId])
}

model OrderLog {
  id         String       @id @default(cuid()) @db.VarChar(30)
  orderId    String       @db.VarChar(30)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  action     String       @db.VarChar(80)
  operatorId String?      @db.VarChar(30)
  remark     String?      @db.VarChar(255)
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id            String        @id @default(cuid()) @db.VarChar(30)
  paymentNo     String        @unique @db.VarChar(32)
  orderId       String        @db.VarChar(30)
  clientRequestId String      @db.VarChar(64)
  channel       String        @db.VarChar(30)
  status        PaymentStatus @default(PENDING)
  amount        Int           @db.UnsignedInt
  transactionId String?       @unique @db.VarChar(100)
  queryCount    Int           @default(0) @db.UnsignedInt
  nextQueryAt   DateTime?
  lastQueriedAt DateTime?
  queryError    String?       @db.VarChar(500)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  order         Order         @relation(fields: [orderId], references: [id])
  callbacks     PaymentCallbackLog[]
  refunds       Refund[]

  @@index([orderId, status])
  @@index([status, nextQueryAt])
  @@unique([orderId, clientRequestId])
}

model PaymentCallbackLog {
  id          String                @id @default(cuid()) @db.VarChar(30)
  channel     String                @db.VarChar(30)
  eventId     String                @db.VarChar(100)
  paymentId   String?               @db.VarChar(30)
  status      PaymentCallbackStatus @default(RECEIVED)
  payload     Json
  errorMessage String?              @db.VarChar(500)
  processedAt DateTime?
  createdAt   DateTime              @default(now())
  payment     Payment?              @relation(fields: [paymentId], references: [id])

  @@unique([channel, eventId])
  @@index([paymentId, createdAt])
  @@index([status, createdAt])
}

model OrderNote {
  id         String   @id @default(cuid()) @db.VarChar(30)
  orderId    String   @db.VarChar(30)
  operatorId String   @db.VarChar(30)
  content    String   @db.VarChar(500)
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Review {
  id          String       @id @default(cuid()) @db.VarChar(30)
  userId      String       @db.VarChar(30)
  orderItemId String       @unique @db.VarChar(30)
  rating      Int          @db.UnsignedTinyInt
  content     String?      @db.VarChar(1000)
  isAnonymous Boolean      @default(false)
  status      ReviewStatus @default(PENDING)
  reviewedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id])
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id])
  images      ReviewImage[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ReviewImage {
  id        String @id @default(cuid()) @db.VarChar(30)
  reviewId  String @db.VarChar(30)
  url       String @db.VarChar(500)
  sortOrder Int    @default(0)
  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, sortOrder])
}

model Shipment {
  id              String   @id @default(cuid()) @db.VarChar(30)
  orderId         String   @unique @db.VarChar(30)
  carrierCode     String   @db.VarChar(50)
  carrierName     String   @db.VarChar(80)
  trackingNumber  String   @db.VarChar(100)
  shippedAt       DateTime @default(now())
  receivedAt      DateTime?
  order           Order    @relation(fields: [orderId], references: [id])

  @@index([carrierCode, trackingNumber])
}

model Coupon {
  id              String      @id @default(cuid()) @db.VarChar(30)
  shopId          String      @db.VarChar(30)
  code            String      @unique @db.VarChar(50)
  name            String      @db.VarChar(120)
  scope           CouponScope @default(ALL)
  thresholdAmount Int         @default(0) @db.UnsignedInt
  discountAmount  Int         @db.UnsignedInt
  totalQuantity   Int         @db.UnsignedInt
  claimedQuantity Int         @default(0) @db.UnsignedInt
  perUserLimit    Int         @default(1) @db.UnsignedInt
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  shop            Shop        @relation(fields: [shopId], references: [id])
  products        CouponProduct[]
  categories      CouponCategory[]
  userCoupons     UserCoupon[]

  @@index([shopId, isActive, startsAt, endsAt])
}

model CouponProduct {
  couponId  String  @db.VarChar(30)
  productId String  @db.VarChar(30)
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
}

model CouponCategory {
  couponId   String   @db.VarChar(30)
  categoryId String   @db.VarChar(30)
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@index([categoryId])
}

model UserCoupon {
  id        String           @id @default(cuid()) @db.VarChar(30)
  userId    String           @db.VarChar(30)
  couponId  String           @db.VarChar(30)
  status    UserCouponStatus @default(AVAILABLE)
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon    Coupon           @relation(fields: [couponId], references: [id])
  usedOrder Order?

  @@index([userId, status, createdAt])
  @@index([couponId, status])
}

model ShippingTemplate {
  id            String   @id @default(cuid()) @db.VarChar(30)
  shopId        String   @db.VarChar(30)
  name          String   @db.VarChar(100)
  baseFee       Int      @default(0) @db.UnsignedInt
  freeThreshold Int?     @db.UnsignedInt
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  shop          Shop     @relation(fields: [shopId], references: [id])
  regionRules   ShippingRegionRule[]

  @@index([shopId, isDefault, isActive])
}

model ShippingRegionRule {
  id         String           @id @default(cuid()) @db.VarChar(30)
  templateId String           @db.VarChar(30)
  province   String           @db.VarChar(80)
  fee        Int              @db.UnsignedInt
  template   ShippingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, province])
}

model HomeBlock {
  id        String        @id @default(cuid()) @db.VarChar(30)
  type      HomeBlockType
  title     String?       @db.VarChar(120)
  content   Json
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([type, isActive, sortOrder])
}

model Favorite {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String   @db.VarChar(30)
  productId String   @db.VarChar(30)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model BrowsingHistory {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String   @db.VarChar(30)
  productId String   @db.VarChar(30)
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
  @@index([productId])
  @@index([viewedAt])
}

model AuditLog {
  id         String   @id @default(cuid()) @db.VarChar(30)
  operatorId String   @db.VarChar(30)
  method     String   @db.VarChar(10)
  path       String   @db.VarChar(255)
  action     String   @db.VarChar(100)
  targetId   String?  @db.VarChar(50)
  requestId  String   @db.VarChar(50)
  ip         String?  @db.VarChar(80)
  userAgent  String?  @db.VarChar(500)
  statusCode Int
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([operatorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model AfterSale {
  id               String          @id @default(cuid()) @db.VarChar(30)
  afterSaleNo      String          @unique @db.VarChar(32)
  clientRequestId  String          @db.VarChar(64)
  orderId          String          @db.VarChar(30)
  userId           String          @db.VarChar(30)
  type             AfterSaleType
  status           AfterSaleStatus @default(PENDING)
  previousOrderStatus OrderStatus
  reason           String          @db.VarChar(255)
  description      String?         @db.VarChar(1000)
  requestedAmount  Int             @db.UnsignedInt
  approvedAmount   Int?            @db.UnsignedInt
  returnCarrierCode String?        @db.VarChar(50)
  returnCarrierName String?        @db.VarChar(80)
  returnTrackingNumber String?     @db.VarChar(100)
  merchantRemark   String?         @db.VarChar(500)
  stockReturnedAt  DateTime?
  remindedAt       DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  order            Order           @relation(fields: [orderId], references: [id])
  user             User            @relation(fields: [userId], references: [id])
  items            AfterSaleItem[]
  logs             AfterSaleLog[]
  refund           Refund?

  @@unique([userId, clientRequestId])
  @@index([orderId, status])
  @@index([status, createdAt])
}

model AfterSaleItem {
  id             String    @id @default(cuid()) @db.VarChar(30)
  afterSaleId    String    @db.VarChar(30)
  orderItemId    String    @db.VarChar(30)
  quantity       Int       @db.UnsignedInt
  refundAmount   Int       @db.UnsignedInt
  afterSale      AfterSale @relation(fields: [afterSaleId], references: [id], onDelete: Cascade)
  orderItem      OrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([afterSaleId, orderItemId])
  @@index([orderItemId])
}

model AfterSaleLog {
  id          String           @id @default(cuid()) @db.VarChar(30)
  afterSaleId String           @db.VarChar(30)
  fromStatus  AfterSaleStatus?
  toStatus    AfterSaleStatus
  action      String           @db.VarChar(80)
  operatorId  String?          @db.VarChar(30)
  remark      String?          @db.VarChar(500)
  createdAt   DateTime         @default(now())
  afterSale   AfterSale        @relation(fields: [afterSaleId], references: [id], onDelete: Cascade)

  @@index([afterSaleId, createdAt])
}

model Refund {
  id              String       @id @default(cuid()) @db.VarChar(30)
  refundNo        String       @unique @db.VarChar(32)
  afterSaleId     String       @unique @db.VarChar(30)
  paymentId       String       @db.VarChar(30)
  clientRequestId String       @unique @db.VarChar(64)
  channel         String       @db.VarChar(30)
  status          RefundStatus @default(PENDING)
  amount          Int          @db.UnsignedInt
  transactionId   String?      @unique @db.VarChar(100)
  errorMessage    String?      @db.VarChar(500)
  retryCount      Int          @default(0) @db.UnsignedInt
  lastAttemptAt   DateTime?
  refundedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  afterSale       AfterSale    @relation(fields: [afterSaleId], references: [id])
  payment         Payment      @relation(fields: [paymentId], references: [id])
  callbacks       RefundCallbackLog[]

  @@index([paymentId, status])
}

model RefundCallbackLog {
  id           String                @id @default(cuid()) @db.VarChar(30)
  channel      String                @db.VarChar(30)
  eventId      String                @db.VarChar(100)
  refundId     String?               @db.VarChar(30)
  status       PaymentCallbackStatus @default(RECEIVED)
  payload      Json
  errorMessage String?               @db.VarChar(500)
  processedAt  DateTime?
  createdAt    DateTime              @default(now())
  refund       Refund?               @relation(fields: [refundId], references: [id])

  @@unique([channel, eventId])
  @@index([refundId, createdAt])
  @@index([status, createdAt])
}
